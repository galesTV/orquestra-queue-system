generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id           String        @id @default(uuid())
  name         String
  appointments Appointment[]
  waitingQueue WaitingQueue[]
  appointmentSlots AppointmentSlot[]
}

model AppointmentSlot {
  id              String        @id @default(uuid())
  startTime       DateTime
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([establishmentId, startTime])
}

model Appointment {
  id              String            @id @default(uuid())
  startTime       DateTime
  status          AppointmentStatus @default(SCHEDULED)
  customerId      String
  establishmentId String
  establishment   Establishment     @relation(fields: [establishmentId], references: [id])
}

model WaitingQueue {
  id              String        @id @default(uuid())
  position        Int
  joinedAt        DateTime      @default(now())
  customerId      String
  establishmentId String
  startTime       DateTime
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@unique([establishmentId, startTime, position])
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
  COMPLETED
  WAITING_CONFIRMATION
}
